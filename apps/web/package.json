{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:deps && vp dev",
    "build": "pnpm run prepare:deps && tsc && vp build",
    "prepare:deps": "pnpm --filter @cubegin/shared build && pnpm --filter @cubegin/scramble-puzzle build && pnpm --filter @cubegin/icons build && pnpm --filter @cubegin/solver build && pnpm --filter @cubegin/scramble-core build && pnpm --filter @cubegin/scramble-image build",
    "preview": "vp preview",
    "test": "pnpm run prepare:deps && vp test",
    "typecheck": "pnpm run prepare:deps && tsc --noEmit"
  },
  "dependencies": {
    "@cubegin/icons": "workspace:*",
    "@cubegin/scramble-core": "workspace:*",
    "@cubegin/scramble-image": "workspace:*",
    "@cubegin/shared": "workspace:*",
    "@cubegin/solver": "workspace:*",
    "@deweyou-design/react": "catalog:",
    "@deweyou-design/react-icons": "catalog:",
    "@deweyou-design/styles": "catalog:",
    "is-mobile": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-is": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
