{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:deps && vp dev",
    "build": "pnpm run prepare:deps && tsc && vp build",
    "prepare:deps": "pnpm --filter @cubekit/timer build && pnpm --filter @cubekit/scramble-puzzle build && pnpm --filter @cubekit/scramble-core build && pnpm --filter @cubekit/scramble-image build",
    "preview": "vp preview",
    "test": "pnpm run prepare:deps && vp test",
    "typecheck": "pnpm run prepare:deps && tsc --noEmit"
  },
  "dependencies": {
    "@cubekit/scramble-core": "workspace:*",
    "@cubekit/scramble-image": "workspace:*",
    "@cubekit/scramble-puzzle": "workspace:*",
    "@cubekit/timer": "workspace:*",
    "@deweyou-design/react": "^0.0.5",
    "@deweyou-design/styles": "^0.0.5",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
