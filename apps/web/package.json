{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:deps && vp dev",
    "build": "pnpm run prepare:deps && tsc && vp build",
    "prepare:deps": "pnpm --filter @cubegin/timer build && pnpm --filter @cubegin/timer-session build && pnpm --filter @cubegin/scramble-puzzle build && pnpm --filter @cubegin/scramble-core build && pnpm --filter @cubegin/scramble-image build",
    "preview": "vp preview",
    "test": "pnpm run prepare:deps && vp test",
    "typecheck": "pnpm run prepare:deps && tsc --noEmit"
  },
  "dependencies": {
    "@cubegin/scramble-core": "workspace:*",
    "@cubegin/scramble-image": "workspace:*",
    "@cubegin/scramble-puzzle": "workspace:*",
    "@cubegin/timer": "workspace:*",
    "@cubegin/timer-session": "workspace:*",
    "@deweyou-design/react": "catalog:",
    "@deweyou-design/styles": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
