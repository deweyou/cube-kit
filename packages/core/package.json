{
  "name": "cubegin",
  "version": "0.0.1",
  "description": "Public Cubegin package entrypoints for scramble generation, parsing, and SVG rendering.",
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./icons": "./dist/icons.mjs",
    "./icons/brand": "./dist/icons/brand.mjs",
    "./icons/events": "./dist/icons/events.mjs",
    "./icons/react": "./dist/icons/react.mjs",
    "./icons/brand/svg/*": "./dist/icons/brand/svg/*",
    "./icons/events/svg/*": "./dist/icons/events/svg/*",
    "./scramble-core": "./dist/scramble-core.mjs",
    "./scramble-image": "./dist/scramble-image.mjs",
    "./scramble-puzzle": "./dist/scramble-puzzle.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "release:prepare": "node scripts/release.mjs",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cubegin/icons": "workspace:*",
    "@cubegin/scramble-core": "workspace:*",
    "@cubegin/scramble-image": "workspace:*",
    "@cubegin/scramble-puzzle": "workspace:*",
    "@cubegin/shared": "workspace:*",
    "@cubegin/solver": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "18 || 19"
  }
}
