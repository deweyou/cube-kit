{
  "name": "@cubegin/cli",
  "version": "0.0.0",
  "description": "Agent-friendly CLI for Cubegin scramble and solver tooling.",
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cubegin/scramble-core": "workspace:*",
    "@cubegin/scramble-image": "workspace:*",
    "@cubegin/scramble-puzzle": "workspace:*",
    "@cubegin/shared": "workspace:*",
    "@cubegin/solver": "workspace:*",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "0.1.19",
    "vitest": "catalog:"
  },
  "cubegin": {
    "publicSubpath": "cli"
  }
}
