{
  "name": "@cubegin/icons",
  "version": "0.0.0",
  "description": "Platform-agnostic SVG icon assets for Cubegin.",
  "license": "GPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./brand": "./dist/brand/index.mjs",
    "./events": "./dist/events/index.mjs",
    "./react": "./dist/react/index.mjs",
    "./package.json": "./package.json",
    "./brand/svg/*": "./dist/brand/svg/*",
    "./events/svg/*": "./dist/events/svg/*"
  },
  "scripts": {
    "build": "vp pack && node scripts/write-svg-files.mjs",
    "dev": "vp pack --watch",
    "test": "vp test && node --test scripts/*.node-test.mjs",
    "test:coverage": "vp test --coverage && node --test scripts/*.node-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cubegin/scramble-puzzle": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
    "vite-plus": "0.1.19",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.19"
  },
  "peerDependencies": {
    "react": "18 || 19"
  },
  "cubegin": {
    "publicSubpath": "icons",
    "publicJsExports": [
      "./brand",
      "./events",
      "./react"
    ],
    "staticAssetExports": {
      "./brand/svg/*": "./dist/brand/svg/*",
      "./events/svg/*": "./dist/events/svg/*"
    }
  }
}
