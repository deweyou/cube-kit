{
  "name": "@cubegin/player",
  "version": "0.0.0",
  "description": "Three.js formula player for Cubegin puzzle events.",
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react/index.mjs",
