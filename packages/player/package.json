    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cubegin/scramble-puzzle": "workspace:*",
    "@cubegin/shared": "workspace:*",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.185.0",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^29.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
    "vite-plus": "0.1.19",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.19"
  },
  "peerDependencies": {
    "react": "18 || 19"
  },
  "cubegin": {
    "publicSubpath": "player",
