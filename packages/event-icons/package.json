{
  "name": "@cubegin/event-icons",
  "version": "0.0.0",
  "description": "Platform-agnostic SVG icons for Cubegin WCA events.",
  "license": "GPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./svg/*": "./dist/svg/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node scripts/write-svg-files.mjs",
    "dev": "vp pack --watch",
    "test": "vp test && node --test scripts/*.node-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cubegin/scramble-puzzle": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
    "vite-plus": "0.1.19",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.19"
  },
  "cubegin": {
    "publicSubpath": "event-icons"
  }
}
